VITE_THEME_NAME="frid" # Eksempel "vestfold" for vestfold-theme (mappe)
VITE_DEFAULT_LANGUAGE="browser" # Options: "browser", "nb", "nn", "en", "se"
VITE_ONBOARDING_API_URI="http://localhost:3000/api" # Trengs ikke om mock-api er true
VITE_ONBOARDING_API_PUBLIC_KEY="Ikke-farlig-nøkkel" # Trengs ikke om mock-api er true
VITE_MOCK_API="false" # Om "true", så mockes alle api-kall
VITE_MOCK_MODE="new" # "new" for å late som "ny konto"-flyt, "existing" for "eksisterende konto"-flyt, "missingphone" for missing KRR phone
VITE_SERVICEDESK_TLF="33 44 55 66"
VITE_SERVICEDESK_EPOST="servicedesk@fylke.no"
VITE_DISABLE_ELEV="true" # Hvis true, vil bruker bli sendt til "ansatt" siden
VITE_SUCCESS_REDIRECT_ANSATT_URL=https://vg.no
VITE_SUCCESS_REDIRECT_ELEV_URL=https://nrk.no